// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid()) @map("_id")
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid()) @map("_id")
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid()) @map("_id")
  name          String?
  username      String?   @unique
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  Post          Post[]
  Comment       Comment[]
  postProgress  UserPostProgress[]
}

model VerificationToken {
  identifier String   @id @map("_id")
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id    String  @id @default(cuid()) @map("_id")
  slug  String  @unique
  title String
  img   String?
  Posts Post[]
}

model Post {
  id        String    @id @default(cuid()) @map("_id")
  createdAt DateTime  @default(now())
  slug      String    @unique
  title     String
  desc      String
  img       String?
  views     Int       @default(0)
  catSlug   String
  cat       Category  @relation(fields: [catSlug], references: [slug])
  userEmail String
  user      User      @relation(fields: [userEmail], references: [email])
  comments  Comment[]

  // Learning path relations
  concepts           PostConcept[]
  relationsFrom      ArticleRelation[]  @relation("ArticleRelationFrom")
  relationsTo        ArticleRelation[]  @relation("ArticleRelationTo")
  progressEntries    UserPostProgress[]

  // Performance indexes for 10k+ users
  @@index([catSlug])
  @@index([createdAt])
  @@index([views])
  @@index([userEmail])
}

model Comment {
  id        String   @id @default(cuid()) @map("_id")
  createdAt DateTime @default(now())
  desc      String
  userEmail String
  user      User     @relation(fields: [userEmail], references: [email])
  postSlug  String
  post      Post     @relation(fields: [postSlug], references: [slug])

  // Performance index for loading comments by post
  @@index([postSlug])
}

// --- Learning path (MVP) ---
// Explicit article→article edges take priority; concept graph is fallback (Decision Q1=C).

model Concept {
  id        String   @id @default(cuid()) @map("_id")
  slug      String   @unique
  title     String
  createdAt DateTime @default(now())

  posts          PostConcept[]
  prerequisites  ConceptPrereq[] @relation("ConceptHasPrereqs")
  requiredBy     ConceptPrereq[] @relation("ConceptIsPrereq")
}

model PostConcept {
  id          String @id @default(cuid()) @map("_id")
  postSlug    String
  conceptSlug String
  post        Post    @relation(fields: [postSlug], references: [slug])
  concept     Concept @relation(fields: [conceptSlug], references: [slug])

  @@unique([postSlug, conceptSlug])
  @@index([postSlug])
  @@index([conceptSlug])
}

model ConceptPrereq {
  id               String  @id @default(cuid()) @map("_id")
  conceptSlug      String
  prerequisiteSlug String
  concept          Concept @relation("ConceptHasPrereqs", fields: [conceptSlug], references: [slug])
  prerequisite     Concept @relation("ConceptIsPrereq", fields: [prerequisiteSlug], references: [slug])

  @@unique([conceptSlug, prerequisiteSlug])
  @@index([conceptSlug])
  @@index([prerequisiteSlug])
}

// type: "next" | "prerequisite" (string for Mongo flexibility)
model ArticleRelation {
  id       String @id @default(cuid()) @map("_id")
  fromSlug String
  toSlug   String
  type     String
  fromPost Post   @relation("ArticleRelationFrom", fields: [fromSlug], references: [slug])
  toPost   Post   @relation("ArticleRelationTo", fields: [toSlug], references: [slug])

  @@unique([fromSlug, toSlug, type])
  @@index([fromSlug])
  @@index([toSlug])
  @@index([type])
}

// status: "viewed" | "completed"
model UserPostProgress {
  id        String   @id @default(cuid()) @map("_id")
  userEmail String
  postSlug  String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userEmail], references: [email])
  post      Post     @relation(fields: [postSlug], references: [slug])

  @@unique([userEmail, postSlug])
  @@index([userEmail])
  @@index([postSlug])
  @@index([status])
}